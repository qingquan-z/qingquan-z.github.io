---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

{items.length > 1 && (
  <nav
    class="page-jump-nav flex w-fit max-w-full flex-wrap items-center gap-0.5 rounded-lg border border-paper-300/90 bg-paper-50/92 px-1 py-1 text-xs dark:border-ink-700 dark:bg-ink-950/92 sm:sticky sm:top-[4.25rem] sm:z-20 sm:flex-nowrap sm:overflow-x-auto sm:rounded-full sm:px-2 sm:backdrop-blur-md"
    aria-label="Page sections"
  >
    {items.map((item) => (
      <a
        href={item.href}
        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full px-1.5 py-1 font-semibold text-ink-600 no-underline transition-colors hover:bg-paper-200/70 hover:text-accent-700 focus-visible:ring-2 focus-visible:ring-accent-500 dark:text-paper-400 dark:hover:bg-ink-800/70 dark:hover:text-accent-300 sm:px-2"
      >
        {item.label}
      </a>
    ))}
  </nav>
)}
